# Vercel Production environment. Fill the empty values before enabling queue mode.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STYLORA_WORKSPACE_ID=
DEMO_WRITES_ENABLED=true
STYLORA_EXECUTION_MODE=queue
# Generate 32 random bytes encoded as base64url. Match the repair-only Vault secret.
STYLORA_DISPATCH_SECRET=
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_REASONING_EFFORT=low
OPENAI_TEXT_MAX_OUTPUT_TOKENS=24000
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_QUALITY=medium
SERPAPI_API_KEY=
# Starting quotas for a small free-tier deployment; provider billing is separate.
STYLORA_TEXT_DAILY_LIMIT=50
STYLORA_IMAGE_DAILY_LIMIT=5
STYLORA_SEARCH_DAILY_LIMIT=30
# Optional: preserve the existing landing sample ID when configured.
STYLORA_LANDING_SAMPLE_LOOK_ID=
# Vercel supplies deployment identity and OIDC automatically. No worker host is needed.
