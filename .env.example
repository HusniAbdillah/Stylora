# Runtime configuration. Copy this file to .env.local.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
STYLORA_WORKSPACE_ID=
DEMO_WRITES_ENABLED=false
# Inline retains the request executor. Queue runs on Vercel; worker is optional.
STYLORA_EXECUTION_MODE=inline
# Required in queue mode; shared only with the reviewed Supabase repair schedule.
STYLORA_DISPATCH_SECRET=
# Optional local QueueClient token override. Never expose it to the browser.
STYLORA_QUEUE_TOKEN=
# Generate a dedicated 32-byte base64url secret. Keep it server-only.
STYLORA_WORKER_SECRET=
STYLORA_WORKER_ORIGIN=http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_REASONING_EFFORT=low
OPENAI_TEXT_MAX_OUTPUT_TOKENS=24000
# Optional task overrides: DESCRIPTION, CONFIDENCE, MATCH, OUTFIT, CAPSULE.
# OPENAI_CAPSULE_MODEL=gpt-6-luna
# OPENAI_CAPSULE_REASONING_EFFORT=low
# OPENAI_CAPSULE_MAX_OUTPUT_TOKENS=9000
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_QUALITY=medium
STYLORA_TEXT_DAILY_LIMIT=150
STYLORA_IMAGE_DAILY_LIMIT=20
STYLORA_SEARCH_DAILY_LIMIT=100
# Set equal limits on the app and worker. Each operation also has a three-call cap.
# Legacy OpenAI API key alias, used only when OPENAI_API_KEY is empty.
MODEL_API_KEY=
OPENAI_MODEL=gpt-6-luna
STYLORA_LANDING_SAMPLE_LOOK_ID=
SERPAPI_API_KEY=

# Owner 1 CLI configuration. Export these in the shell before using the CLI.
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
