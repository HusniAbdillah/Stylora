{
  "name": "stylora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format:check": "prettier --check src scripts package.json tsconfig.json eslint.config.mjs next.config.ts postcss.config.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:test": "supabase test db supabase/tests"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
